# 复制为项目根目录 application-local.properties 后填写真实值。
# 此示例可提交；真实文件已被 .gitignore 排除，不得放到 src/main/resources。
# 使用 Java properties 格式，值两侧不要添加 shell 引号。
MYSQL_URL=jdbc:mysql://localhost:3306/winter_upload_v2?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=winter_upload
MYSQL_PASSWORD=replace_me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=replace_me
RUSTFS_SECRET_KEY=replace_me
RUSTFS_BUCKET=winter-upload-v2
